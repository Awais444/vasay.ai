# Copy to .env.local and fill in.
RESEND_API_KEY=
# The inbox that receives contact form enquiries
CONTACT_TO_EMAIL=info@smartsolutionsinc.ca
# Sender on a domain verified in Resend (add its SPF + DKIM DNS records first). Replies go to the visitor.
CONTACT_FROM_EMAIL="Smart Solutions <noreply@smartsolutionsinc.ca>"
# Optional GoHighLevel inbound webhook
GHL_WEBHOOK_URL=
# Leave empty for /api/contact (Node hosting). Set to /contact.php for static export.
NEXT_PUBLIC_FORM_ENDPOINT=

# ---- Insights blog (Sanity) ----
# From sanity.io/manage → your project. The site builds without these (the blog shows "coming soon").
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Long random string; the same value goes in the Sanity webhook's "Secret" field.
SANITY_REVALIDATE_SECRET=
# Only for `npm run sanity:seed` (Editor token from sanity.io/manage → API → Tokens). Never commit it.
SANITY_API_WRITE_TOKEN=

# ---- SEO & analytics ----
# Canonical origin (https, no www, no trailing slash). Used for canonicals, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://vasay.ai
# Off Vercel: set to 1 on staging servers to block indexing (Vercel previews are blocked automatically).
NEXT_PUBLIC_NOINDEX=
# Google Analytics 4 (G-XXXXXXX) and/or Google Tag Manager (GTM-XXXXXXX). Loaded on production only.
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GTM_ID=
# Search Console + Bing Webmaster verification codes (the content="..." value only).
NEXT_PUBLIC_GSC_VERIFICATION=
NEXT_PUBLIC_BING_VERIFICATION=
